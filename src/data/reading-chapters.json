          "hero_female": "dialogue-hero-rakoro-nous-venons-reprendre-ce-que-tu-as-vole-feminine-daee15349c68.wav"
        }
      },
      {
        "who": "demon",
        "text": "Ra, ri, ro, ru, ré, rou ! Je les ai cachées. Vous ne lirez plus ces syllabes !",
        "audio_files": {
          "demon": "dialogue-demon-ra-ri-ro-ru-re-rou-je-les-ai-cachees-vous-ne-lirez-plus-ces-syllabes-11c23f8c2182.wav"
        }
      },
