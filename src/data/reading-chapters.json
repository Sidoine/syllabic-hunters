  {
    "id": 2,
    "label": "M",
    "letters": [
      "m"
    ],
    "title": "La lettre M",
    "boss": "Maître Moustache",
    "hue": 300,
    "color": "#ff7ad9",
    "intro": [
      {
        "who": "mochi",
        "text": "Maître Moustache a volé les syllabes en M et les cache dans le marché.",
        "audio_files": {
          "mochi": "dialogue-mochi-maitre-moustache-a-vole-les-syllabes-en-m-et-les-cache-dans-le-marche-ac69407fe89f.wav"
        }
      },
      {
        "who": "hero",
        "text": "On va les retrouver et les rendre aux mots !",
        "audio_files": {
