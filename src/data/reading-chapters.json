          "hero_female": "dialogue-hero-on-va-les-retrouver-et-les-rendre-aux-mots-feminine-d6a53dc60de7.wav"
        }
      },
      {
        "who": "demon",
        "text": "Ma, mi, mo, mu, mé, mou ! Ces syllabes sont à moi. Le Roi Chuuut sera fier !",
        "audio_files": {
          "demon": "dialogue-demon-ma-mi-mo-mu-me-mou-ces-syllabes-sont-a-moi-le-roi-chuuut-sera-fier-fe8833de02ad.wav"
        }
      },
      {
        "who": "mochi",
        "text": "Écoutons les sons et suivons les indices de Maître Moustache.",
        "audio_files": {
          "mochi": "dialogue-mochi-ecoutons-les-sons-et-suivons-les-indices-de-maitre-moustache-413b032a9bc1.wav"
        }
      }
    ],
    "outro": [
      {
        "who": "demon",
        "text": "Mince, je suis vaincu ! Je rends ma, mi, mo, mu, mé et mou. Prenez-les !",
        "audio_files": {
          "demon": "dialogue-demon-mince-je-suis-vaincu-je-rends-ma-mi-mo-mu-me-et-mou-prenez-les-98c93b3dd425.wav"
        }
      },
      {
        "who": "mochi",
        "text": "Les syllabes en M sont libres. Les mots vont pouvoir les retrouver.",
        "audio_files": {
          "mochi": "dialogue-mochi-les-syllabes-en-m-sont-libres-les-mots-vont-pouvoir-les-retrouver-9fce52e1a100.wav"
        }
      },
      {
        "who": "hero",
        "text": "Encore un démon du Roi Chuuut à déjouer. En route !",
        "audio_files": {
          "hero_male": "dialogue-hero-encore-un-demon-du-roi-chuuut-a-dejouer-en-route-masculine-96f0f8d8c0ef.wav",
          "hero_female": "dialogue-hero-encore-un-demon-du-roi-chuuut-a-dejouer-en-route-feminine-e26f223a44f2.wav"
        }
      }
    ],
