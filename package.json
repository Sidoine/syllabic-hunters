{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite\"",
    "prebuild": "npm run assets:pull:final",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
	"assets:seafile": "node scripts/seafile-assets.mjs",
	"assets:status": "npm run assets:seafile -- status",
	"assets:push": "npm run assets:seafile -- push",
	"assets:pull": "npm run assets:seafile -- pull",
	"assets:pull:final": "npm run assets:seafile -- pull-final",
	"hooks:install": "node scripts/install-git-hooks.mjs",
	"voice:catalog": "tsx .agents/skills/generate-voice/scripts/build_voice_catalog.ts",
    "lint": "biome lint .",
	"test:map": "tsx --test tests/map-layout.test.ts",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.17",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
